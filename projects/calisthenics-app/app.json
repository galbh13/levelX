{
  "expo": {
    "name": "The System",
    "slug": "levelx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050912"
    },
    "ios": {
      "bundleIdentifier": "com.galbenhamo.thesystem",
      "supportsTablet": true
    },
    "android": {
      "package": "com.galbenhamo.thesystem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050912"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a030e9a0-893e-41e2-8d62-306e32485a57"
      }
    },
    "plugins": [
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "The System uses your photo library so you can set your player portrait and upload your check-up and signature clips for your coach.",
          "cameraPermission": "The System uses your camera so you can film your check-up and signature clips for your coach."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/a030e9a0-893e-41e2-8d62-306e32485a57"
    },
    "runtimeVersion": "07c63e4cb5e84bbf0516780f79dada6931589db8"
  }
}
